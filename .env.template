# .env.template
#
# It is a template file for .env file which contains all the environment
# variables used in the docker-compose.yml file.
#
# Should be copied to .env file and filled with the correct values.

# irem - irem configuration
DATA_IREM_RAW_DIR=

# influxdb - influxdb configuration
DOCKER_INFLUXDB_INIT_USERNAME=''
DOCKER_INFLUXDB_INIT_PASSWORD=''
DOCKER_INFLUXDB_INIT_ORG=''
DOCKER_INFLUXDB_INIT_BUCKET=''
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=''
DOCKER_INFLUXDB_INIT_IREM_BUCKET=''

# grafana - grafana configuration
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
GF_VIEWER_LOGIN=
GF_VIEWER_PASSWORD=

#prometheus
RETENTION_SIZE=5GB # size of machine benchmarking data to be retained

# elasticsearch
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g   # Memory settings for ES JVM
ELASTICSEARCH_DISCOVERY_TYPE=single-node

# kibana
KIBANA_ELASTICSEARCH_USERNAME=
KIBANA_ELASTICSEARCH_PASSWORD=

# One-time full reprocessing (set to 1 to reprocess all existing data without re-downloading)
REPROCESS_ALL_DATA=0

#Chunk size for IREM uploads (rows per batch)
IREM_CHUNK_ROWS=500000

# Accumulation interval (seconds) each IREM D1/D2/D3/Coincidence COUNTRATE sample
# covers, used to normalize COUNT into COUNTS_PER_MIN. Must match the real CDF
# EPOCH cadence - defaults to 1.0 in irem_process.py if unset, which is wrong.
IREM_CADENCE_SECONDS=60

#RADEM chunk size for uploads (rows per batch)
RADEM_CHUNK_ROWS=100000